{
  "manifest_version": 3,
  "name": "Tracker Beta",
  "version": "0.1.0",
  "description": "Local browser activity audit logger.",
  "permissions": [
    "webNavigation"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tracker Beta"
  }
}

